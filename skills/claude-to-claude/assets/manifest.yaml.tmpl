# .handoff/manifest.yaml — SKELETON / reference only.
# The real manifest is generated by scripts/assemble_bundle.py from the spec JSON.
# This file documents the schema (see references/bundle-format.md). Do not ship this
# skeleton as the bundle manifest.

c2c_schema: 1                    # bundle format version
created: "YYYY-MM-DD"            # date the bundle was assembled (passed in; no clock access)
source_commit: "<full-sha>"     # HEAD at packaging time — the freshness stamp
source_branch: "<branch>"
project_name: "<name>"
sender:
  name: "<departing owner>"
  contact: "<email / handle>"   # light return channel for residual Q&A
recipient_hint: "<who this is for, or null>"
first_task: "<low-risk starter, or null>"
provenance_summary:
  declared: 0                   # counts for a trust-at-a-glance readout
  inferred: 0
  uncertain: 0
sanitization:
  secret_scan: "clean"          # MUST be clean before sharing
  scanned_at_commit: "<sha>"
  depersonalized: true          # sender global config confirmed excluded
  paths_placeholdered: true     # absolute paths swapped for placeholders
environment:
  requires_mcp: []              # MCP server needs (names), reconstructed by recipient
  requires_secrets: []          # ENV VAR names only — never values
  external_services: []
status: "packaged"              # packaged | in_transition | graduated
